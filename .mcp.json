{
  "mcpServers": {
    "sonarqube": {
      "command": "npx",
      "args": [
        "dotenv-cli",
        "-e", ".env.mcp",
        "--", "docker", "run", "-i", "--rm", "--init", "--pull=always", "--network=host",
        "-e", "SONARQUBE_TOKEN",
        "-e", "SONARQUBE_URL",
        "-e", "SONARQUBE_IDE_PORT",
        "-v", ".:/app/mcp-workspace:ro",
        "mcp/sonarqube"
      ]
    }
  }
}
